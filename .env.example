REDLENS_DATABASE_URL=sqlite:///./redlens.db
REDLENS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Long-lived API key for the oe-ai-agent sidecar. Required for live
# targets — RedLens uses it to mint short-lived OpenEMR FHIR tokens
# on demand via the agent's /v1/openemr/mint-token endpoint. Issue with:
#   uv run python -m oe_ai_agent.admin.issue_api_key
# inside the oe-ai-agent repo, paste the token here, paste the hash
# into OE_AI_AGENT_API_KEY_HASHES on the agent service.
OE_AI_AGENT_API_KEY=

VITE_API_BASE_URL=http://127.0.0.1:8000
