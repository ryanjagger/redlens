REDLENS_DATABASE_URL=postgresql+psycopg://redlens:redlens@127.0.0.1:5432/redlens
REDLENS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Long-lived API key for the oe-ai-agent sidecar. Required for live
# targets — RedLens uses it to mint short-lived OpenEMR FHIR tokens
# on demand via the agent's /v1/openemr/mint-token endpoint. Issue with:
#   uv run python -m oe_ai_agent.admin.issue_api_key
# inside the oe-ai-agent repo, paste the token here, paste the hash
# into OE_AI_AGENT_API_KEY_HASHES on the agent service.
OE_AI_AGENT_API_KEY=

# Optional. Required only for llm_assisted exploration campaigns.
OPENROUTER_API_KEY=sk-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=RedLens
REDLENS_RED_TEAM_MODEL=anthropic/claude-sonnet-4.5
REDLENS_JUDGE_MODEL=
REDLENS_DOCUMENTER_MODEL=

VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional. Enables Langfuse tracing for campaign graph and OpenRouter calls.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_ENVIRONMENT=default
