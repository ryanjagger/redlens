REDLENS_DATABASE_URL=sqlite:///./redlens.db
REDLENS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Live OpenEMR target secrets are referenced by env var name in RedLens targets.
# Do not store real values in SQLite.
OPENEMR_INTERNAL_AUTH_SECRET=replace-me
OPENEMR_BEARER_TOKEN=replace-me
OPENEMR_FHIR_BASE_URL=http://127.0.0.1:8300/apis/default/fhir
OPENEMR_AI_AGENT_BASE_URL=http://127.0.0.1:8001

VITE_API_BASE_URL=http://127.0.0.1:8000

